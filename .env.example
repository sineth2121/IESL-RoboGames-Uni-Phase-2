# ArduPilot SITL + Webots Environment Configuration
# Copy this file to .env and adjust paths as needed
#
# Usage: cp .env.example .env

# === Webots Installation ===
# Uncomment the appropriate section for your installation type

# Standard installation (apt/deb)
WEBOTS_HOME=/usr/local/webots
WEBOTS_TMP_PATH=/tmp/webots

# Snap installation (uncomment these, comment out the above)
# WEBOTS_HOME=/snap/webots/current/usr/share/webots
# WEBOTS_TMP_PATH=~/snap/webots/common/tmp/webots

# === Display ===
# Usually :0, verify with: echo $DISPLAY
DISPLAY=:0

# === External Webots Controller URL ===
# Optional override. If unset, ./start.sh chooses a runtime-specific default:
# - Podman: tcp://host.containers.internal:1234/Iris
# - Docker: tcp://host.docker.internal:1234/Iris
# WEBOTS_CONTROLLER_URL=tcp://host.containers.internal:1234/Iris